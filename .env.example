# ===================================================
# AI for Legal Assistance & Access - Environment Config
# ===================================================

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Default Legal Jurisdiction
DEFAULT_JURISDICTION=IN

# Application Settings
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000
